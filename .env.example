NUXT_PUBLIC_WAROLABS_API_URL=http://localhost:4000
NUXT_BASE_URL=https://warocol.com
NUXT_API_KEY=your_api_key_here

# Docker build heap limit in MiB (Nuxt production build)
NODE_BUILD_MAX_OLD_SPACE_SIZE=6144

# Google Tag Manager
NUXT_PUBLIC_GTM_CONTAINER_ID="GTM-XXXXXXX"

# Paddle.js (Billing checkout on /billing/confirmacion) — LIVE via PADDLE_KEYS.txt, WOMPI deprecado
NUXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_bdd5e1eb709b6d785ec7677d00b # from PADDLE_KEYS.txt:3
NUXT_PUBLIC_PADDLE_ENVIRONMENT=production
# API prod also needs: PADDLE_ENVIRONMENT=production, PADDLE_API_KEY_LIVE=pdl_live_..., PADDLE_WEBHOOK_SECRET_LIVE=pdl_ntfset_..., PADDLE_PRICE_*_LIVE=pri_01m... (from PADDLE_KEYS.txt:8, not in git)
